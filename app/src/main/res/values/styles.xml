<?xml version="1.0" encoding="utf-8"?>
<resources>

  <style name="TitleText">
    <item name="android:textSize">16sp</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:textColor">@color/title_color</item>
    <item name="android:lines">1</item>
    <item name="android:maxLines">1</item>
  </style>

  <style name="ToolBarArea">
    <item name="android:elevation">0dp</item>
  </style>

  <style name="ToolbarStyle" parent="ThemeOverlay.AppCompat.DayNight.ActionBar">
    <item name="iconTint">@color/toolbar_icon_tint</item>
    <item name="android:textColorPrimary">@color/toolbar_text</item>
    <item name="android:textColorSecondary">@color/toolbar_secondary_text</item>
  </style>

  <style name="ToolbarTitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
    <item name="android:textSize">20sp</item>
    <item name="android:fontFamily">sans-serif-medium</item>
  </style>

  <style name="ToolbarSubtitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Subtitle">
    <item name="android:textSize">13sp</item>
    <item name="android:textColor">@color/accent_color</item>
  </style>

  <!-- the ⋮ menus: rounded, raised, roomier rows -->
  <style name="QuranPopupTheme" parent="ThemeOverlay.AppCompat.DayNight">
    <item name="popupMenuStyle">@style/QuranPopupMenu</item>
    <item name="actionOverflowMenuStyle">@style/QuranPopupMenu.Overflow</item>
    <item name="listPreferredItemHeightSmall">52dp</item>
    <item name="listPreferredItemPaddingLeft">20dp</item>
    <item name="listPreferredItemPaddingRight">24dp</item>
    <item name="textAppearanceLargePopupMenu">@style/QuranPopupMenuText</item>
    <item name="textAppearanceSmallPopupMenu">@style/QuranPopupMenuText</item>
    <item name="colorAccent">@color/accent_color</item>
  </style>

  <style name="QuranPopupMenu" parent="Widget.AppCompat.PopupMenu">
    <item name="android:popupBackground">@drawable/menu_popup</item>
    <item name="android:popupElevation">10dp</item>
    <item name="android:dropDownVerticalOffset">4dp</item>
  </style>

  <style name="QuranPopupMenu.Overflow" parent="Widget.AppCompat.PopupMenu.Overflow">
    <item name="android:popupBackground">@drawable/menu_popup</item>
    <item name="android:popupElevation">10dp</item>
    <item name="overlapAnchor">false</item>
    <item name="android:dropDownVerticalOffset">4dp</item>
  </style>

  <style name="QuranPopupMenuText" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
    <item name="android:textSize">16sp</item>
  </style>

  <!-- settings: switches instead of checkboxes, and bold section titles -->
  <style name="QuranPreferenceTheme" parent="PreferenceThemeOverlay">
    <item name="checkBoxPreferenceStyle">@style/QuranSwitchPreference</item>
    <item name="preferenceCategoryStyle">@style/QuranPreferenceCategory</item>
  </style>

  <style name="QuranSwitchPreference" parent="Preference.CheckBoxPreference.Material">
    <item name="android:widgetLayout">@layout/pref_switch_widget</item>
  </style>

  <style name="QuranPreferenceCategory" parent="Preference.Category.Material">
    <item name="android:layout">@layout/pref_category</item>
  </style>

  <style name="NotificationText" parent="android:TextAppearance.StatusBar.EventContent" />

  <style name="NotificationTitle" parent="android:TextAppearance.StatusBar.EventContent.Title" />

  <style name="QuranDialogTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
    <item name="android:backgroundDimAmount">0.4</item>
    <item name="buttonBarPositiveButtonStyle">@style/QuranDialogButton.Positive</item>
    <item name="buttonBarNegativeButtonStyle">@style/QuranDialogButton</item>
    <item name="buttonBarNeutralButtonStyle">@style/QuranDialogButton</item>
    <item name="android:windowTitleStyle">@style/QuranDialogTitle</item>
    <item name="android:windowBackground">@drawable/dialog_background</item>
    <item name="colorAccent">@color/accent_color</item>
  </style>

  <!-- screens slide in a little and fade, and slide back out on close -->
  <style name="QuranWindowAnimation" parent="@android:style/Animation.Activity">
    <item name="android:activityOpenEnterAnimation">@anim/activity_open_enter</item>
    <item name="android:activityOpenExitAnimation">@anim/activity_open_exit</item>
    <item name="android:activityCloseEnterAnimation">@anim/activity_close_enter</item>
    <item name="android:activityCloseExitAnimation">@anim/activity_close_exit</item>
  </style>

  <style name="TranslationText">
    <item name="android:textColor">@android:color/black</item>
    <item name="android:textSize">14sp</item>
  </style>

  <style name="TranslationText.Highlighted">
    <item name="android:textColor">@color/translation_highlight</item>
  </style>

  <style name="TranslationText.NightMode">
    <item name="android:background">@android:color/black</item>
    <item name="android:textColor">@android:color/white</item>
  </style>

  <style name="TranslationText.NightMode.Highlighted">
    <item name="android:textColor">@color/translation_highlight</item>
  </style>

  <style name="PageTypeTitle">
    <item name="android:textColor">@android:color/white</item>
    <item name="android:textSize">18sp</item>
    <item name="android:textStyle">bold</item>
  </style>

  <style name="PageTypeDescription">
    <item name="android:textColor">#aaaaaa</item>
    <item name="android:textSize">16sp</item>
  </style>

  <style name="SearchResult">
    <item name="android:textColor">@color/text_primary</item>
    <item name="android:textSize">17sp</item>
  </style>

  <style name="SearchResult.Location">
    <item name="android:textColor">@color/accent_color</item>
    <item name="android:textSize">13sp</item>
    <item name="android:textStyle">bold</item>
  </style>

  <style name="PanelLabel">
    <item name="android:textColor">@color/panel_label</item>
    <item name="android:textSize">14sp</item>
    <item name="android:textStyle">bold</item>
  </style>

  <!-- a rounded group of settings in the verse panel -->
  <style name="PanelCard">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginBottom">12dp</item>
    <item name="android:background">@drawable/panel_card</item>
    <item name="android:orientation">vertical</item>
    <item name="android:paddingStart">16dp</item>
    <item name="android:paddingEnd">12dp</item>
    <item name="android:paddingTop">12dp</item>
    <item name="android:paddingBottom">8dp</item>
  </style>

  <style name="SherlockDropDownItem">
    <item name="android:textAppearance">@style/SherlockDropDownItemText</item>
    <item name="android:paddingLeft">8dp</item>
    <item name="android:paddingRight">8dp</item>
    <item name="android:gravity">center_vertical</item>
  </style>

  <style name="SherlockDropDownItemText">
    <item name="android:textColor">@color/sherlock_primary_text_disable</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textStyle">normal</item>
  </style>

  <style name="SherlockSpinnerItem">
    <item name="android:textAppearance">@style/SherlockSpinnerItemText</item>
    <item name="android:paddingLeft">8dp</item>
    <item name="android:paddingRight">8dp</item>
  </style>

  <style name="SherlockSpinnerItemText">
    <item name="android:textColor">@color/sherlock_primary_text</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textStyle">normal</item>
  </style>

  <style name="ToastText">
    <item name="android:textSize">14sp</item>
    <item name="android:textStyle">normal</item>
    <item name="fontFamily">sans-serif</item>
  </style>

  <style name="QuranDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
    <item name="android:textColor">@color/accent_color</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textSize">15sp</item>
    <item name="android:minWidth">72dp</item>
  </style>

  <!-- the main action: a filled pill -->
  <style name="QuranDialogButton.Positive">
    <item name="android:textColor">@color/panel_button_text</item>
    <item name="android:background">@drawable/dialog_positive_button</item>
    <item name="android:layout_marginStart">8dp</item>
    <item name="android:paddingStart">20dp</item>
    <item name="android:paddingEnd">20dp</item>
  </style>

  <style name="QuranDialogTitle" parent="RtlOverlay.DialogWindowTitle.AppCompat">
    <item name="android:textAppearance">@style/QuranDialogTitleText</item>
  </style>

  <style name="QuranDialogTitleText" parent="TextAppearance.AppCompat.Title">
    <item name="android:textSize">20sp</item>
    <item name="android:fontFamily">sans-serif-medium</item>
  </style>

  <!-- a boxed text field, for the go to page dialog -->
  <style name="QuranField">
    <item name="android:background">@drawable/field_box</item>
    <item name="android:paddingStart">14dp</item>
    <item name="android:paddingEnd">14dp</item>
    <item name="android:paddingTop">12dp</item>
    <item name="android:paddingBottom">12dp</item>
    <item name="android:textSize">17sp</item>
  </style>
</resources>
